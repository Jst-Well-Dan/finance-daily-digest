# 解读君视频日报 · 本地配置
# ---------------------------------------------------------------------------
# 复制本文件为 .env 后按需修改（.env 已在 .gitignore 中，不会被提交）。
# 格式：KEY=value，不要给整行加引号之外的装饰；值含空格才需要引号。
# 命令行显式赋值优先于本文件：`YOUTUBE_CLEAN_MODEL=x python run_daily.py`
# ---------------------------------------------------------------------------

# ===== 模型（唯一需要常改的地方）=====
# 全部 provider 前缀必须写全。裸模型名在多个 provider 下同名时，
# pi 会直接报 "Model xxx is ambiguous across providers" 而失败。
#
# 当前可用（2026-11 实测）：opendesign / deepseek / openai-codex / antigravity
# 已失效：muse-spark-1.3-contributor（openCode Go 订阅返回 403）

# 结构化笔记 + 一句话 TL;DR 用
YOUTUBE_NOTES_MODEL=opendesign/deepseek-v4.1-flash

# 转写稿清洗（规则层之后的 LLM 精修）用；留空则跟随 YOUTUBE_NOTES_MODEL
# 清洗任务对「不许概括」很敏感，建议用长上下文、指令遵循稳的模型
YOUTUBE_CLEAN_MODEL=opendesign/deepseek-v4.1-flash

# ===== 转写 =====
# SiliconFlow 语音转写 API Key（必填，否则转写全失败）
SILICONFLOW_API_KEY=

# ===== 抓取范围 =====
# 下载窗口下界兜底天数：防止窗口外漏片永远补不回来
YOUTUBE_BACKFILL_DAYS=45

# 频道列表，空格分隔。默认只抓解读君。
# 想加频道直接追加 URL，例如：
# YOUTUBE_CHANNELS=https://www.youtube.com/@JIEDU369/videos https://www.youtube.com/@另一个频道/videos
YOUTUBE_CHANNELS=https://www.youtube.com/@JIEDU369/videos

# YouTube cookies 文件路径（可选，云端/风控时可解决 403）
# YOUTUBE_COOKIES=cookies.txt

# ===== 清洗行为 =====
# 1 = 只跑规则层，不调 LLM（免费、秒级，但修不了 ASR 错字）
YOUTUBE_CLEAN_RULES_ONLY=0

# 单篇 LLM 超时秒数
YOUTUBE_CLEAN_TIMEOUT=900
